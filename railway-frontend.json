{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "packages/frontend/Dockerfile",
    "watchPatterns": [
      "docs/**",
      "packages/shared/**",
      "packages/frontend/**"
    ]
  },
  "deploy": {
    "startCommand": "cd packages/frontend && npm start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}

