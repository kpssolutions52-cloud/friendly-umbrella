# Server
NODE_ENV=development
PORT=8000
API_URL=http://localhost:8000

# Frontend
WEB_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/construction_pricing?schema=public

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis (Optional for MVP)
REDIS_URL=redis://localhost:6379

# File Storage (Optional for MVP)
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# CORS
# Comma-separated list of allowed origins (Vercel domains are included by default)
# Example: CORS_ORIGIN=http://localhost:3000,https://yourdomain.com
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info

# ─── AI / OpenAI ──────────────────────────────────────────────────────────────
# Used for NLP intent extraction and RFQ draft generation.
# Without this the system uses a keyword fallback (still works, less smart).
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ─── Procurement: Email (SMTP) ────────────────────────────────────────────────
# Gmail: use an App Password (Google Account → Security → App Passwords)
# Outlook: use smtp.office365.com port 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM=your-gmail@gmail.com
COMPANY_NAME=ConstructionGuru

# ─── Procurement: WhatsApp (Twilio) ───────────────────────────────────────────
# Sign up at twilio.com → Messaging → Try WhatsApp Sandbox (free for testing)
# Sandbox number is always whatsapp:+14155238886
# Your phone must first send "join <sandbox-keyword>" to that number to opt in
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token-here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── Procurement: Supplier Web Discovery (Google Custom Search) ───────────────
# Optional. Without this, only internal DB suppliers are found.
# Setup: console.cloud.google.com → Custom Search JSON API → programmablesearchengine.google.com
GOOGLE_SEARCH_API_KEY=AIza...
GOOGLE_SEARCH_CX=your-search-engine-id













