# ─── Core ─────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/constructionguru
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here
JWT_EXPIRES_IN=15m

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Optional: planner model for QS chat web enrichment (defaults to gpt-4o-mini)
OPENAI_WEB_ENRICHMENT_MODEL=gpt-4o-mini

# ─── Supabase (storage) ───────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# ─── AI Procurement Agent: Email (SMTP) ───────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=procurement@yourcompany.com
COMPANY_NAME=ConstructionGuru

# ─── AI Procurement Agent: WhatsApp (Twilio) ──────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── Google Custom Search (QS chat web enrichment + procurement) ───────────────
GOOGLE_SEARCH_API_KEY=AIza...
GOOGLE_SEARCH_CX=your-custom-search-engine-id

# ─── App URL (for Twilio webhook validation) ──────────────────────────────────
APP_URL=https://your-domain.com
