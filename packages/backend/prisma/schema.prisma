// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// 
// SIMPLIFIED SCHEMA FOR AI QS ASSISTANT
// After running database migrations, this schema matches the new simplified structure
// See database/MIGRATION_README.md for migration instructions

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Organizations (Companies and Suppliers)
model Organization {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(255)
  type      OrgType
  email     String   @unique @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                User[]                 @relation("OrganizationUsers")
  products             Product[]              @relation("SupplierProducts")
  projects             Project[]              @relation("CompanyProjects")
  companyPrices        CompanyPrice[]         @relation("CompanyPrices")
  quoteResponses       QuoteResponse[]        @relation("SupplierQuoteResponses")
  orders               Order[]                @relation("SupplierOrders")
  procurementRequests  ProcurementRequest[]   @relation("OrgProcurementRequests")
  supplierCandidates   RfqSupplierCandidate[] @relation("OrgSupplierCandidates")

  @@index([type])
  @@map("organizations")
}

enum OrgType {
  company
  supplier
}

enum TenantType {
  supplier
  company
}

enum TenantStatus {
  pending
  active
  rejected
}

enum PriceType {
  default
  private
}

// Users (QS Professionals and Suppliers)
model User {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  email          String   @unique @db.VarChar(255)
  passwordHash   String   @map("password_hash") @db.VarChar(255)
  name           String?  @db.VarChar(255)
  type           UserType
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization          Organization         @relation("OrganizationUsers", fields: [organizationId], references: [id], onDelete: Cascade)
  projects              Project[]            @relation("ProjectOwner")
  quotes                Quote[]              @relation("QuoteCreator")
  quoteRequests         QuoteRequest[]       @relation("QuoteRequestCreator")
  priceAuditLogs        PriceAuditLog[]      @relation("PriceAuditLogUser")
  priceViews            PriceView[]          @relation("PriceViewUser")
  procurementRequests   ProcurementRequest[] @relation("UserProcurementRequests")

  @@index([organizationId])
  @@index([email])
  @@index([type])
  @@map("users")
}

enum UserType {
  qs
  supplier
}

// Products (from Suppliers only)
model Product {
  id                String   @id @default(uuid())
  supplierId        String   @map("supplier_id")
  name              String   @db.VarChar(255)
  sku               String   @db.VarChar(100) // SKU (Stock Keeping Unit) - auto-generated if not provided
  price             Decimal  @db.Decimal(12, 2) // Base/default price
  unit              String   @db.VarChar(50)
  stockAvailability String?  @map("stock_availability") @db.VarChar(100) // Stock status: "in_stock", "out_of_stock", "low_stock", or quantity info
  isActive          Boolean  @default(true) @map("is_active")
  updatedAt         DateTime @updatedAt @map("updated_at")
  createdAt         DateTime @default(now()) @map("created_at")

  supplier           Organization        @relation("SupplierProducts", fields: [supplierId], references: [id], onDelete: Cascade)
  companyPrices      CompanyPrice[] // Company-specific prices
  defaultPrices      DefaultPrice[] // Default prices
  privatePrices      PrivatePrice[] // Private prices
  priceAuditLogs     PriceAuditLog[] // Price audit logs
  priceViews         PriceView[] // Price views
  quoteResponseItems QuoteResponseItem[]
  quoteItems         QuoteItem[] // Items in quotes that reference this product
  orderItems         OrderItem[]         @relation("OrderProduct")

  @@index([name])
  @@index([supplierId])
  @@index([isActive])
  @@map("products")
}

// Company-Specific Prices (Special prices for specific companies)
model CompanyPrice {
  id             String    @id @default(uuid())
  productId      String    @map("product_id")
  companyId      String    @map("company_id")
  price          Decimal   @db.Decimal(12, 2) // Special price for this company
  effectiveFrom  DateTime  @default(now()) @map("effective_from")
  effectiveUntil DateTime? @map("effective_until") // null = no expiration
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  company Organization @relation("CompanyPrices", fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([productId, companyId, effectiveFrom]) // One price per product-company-effectiveFrom
  @@index([productId])
  @@index([companyId])
  @@index([effectiveFrom])
  @@map("company_prices")
}

// Projects (QS Projects - each company manages independently)
model Project {
  id          String        @id @default(uuid())
  companyId   String        @map("company_id")
  ownerId     String        @map("owner_id")
  name        String        @db.VarChar(255)
  description String?       @db.Text
  type        String?       @db.VarChar(100) // commercial, residential, etc.
  location    String?       @db.VarChar(255)
  status      ProjectStatus @default(planning)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  company       Organization   @relation("CompanyProjects", fields: [companyId], references: [id], onDelete: Cascade)
  owner         User           @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  quotes        Quote[]
  quoteRequests QuoteRequest[] @relation("ProjectQuoteRequests")
  orders        Order[]        @relation("ProjectOrders")

  @@index([companyId])
  @@index([ownerId])
  @@index([status])
  @@map("projects")
}

enum ProjectStatus {
  planning
  active
  completed
  cancelled
}

// Quotes (Project Quotes)
model Quote {
  id          String      @id @default(uuid())
  projectId   String?     @map("project_id")
  createdById String      @map("created_by_id")
  title       String      @db.VarChar(255)
  description String?     @db.Text
  totalAmount Decimal     @db.Decimal(12, 2)
  status      QuoteStatus @default(draft)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  project Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  creator User        @relation("QuoteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  items   QuoteItem[]

  @@index([projectId])
  @@index([createdById])
  @@index([status])
  @@map("quotes")
}

enum QuoteStatus {
  draft
  sent
  accepted
  rejected
}

// Quote Items (Materials in Quote)
model QuoteItem {
  id        String   @id @default(uuid())
  quoteId   String   @map("quote_id")
  productId String?  @map("product_id")
  name      String   @db.VarChar(255)
  quantity  Decimal  @db.Decimal(10, 2)
  unit      String   @db.VarChar(50)
  price     Decimal  @db.Decimal(12, 2)
  total     Decimal  @db.Decimal(12, 2)
  supplier  String?  @db.VarChar(255) // Supplier name
  createdAt DateTime @default(now()) @map("created_at")

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([productId])
  @@map("quote_items")
}

// Quote Request (QS requests quotes from suppliers)
model QuoteRequest {
  id          String             @id @default(uuid())
  projectId   String             @map("project_id")
  createdById String             @map("created_by_id")
  title       String             @db.VarChar(255)
  description String?            @db.Text
  status      QuoteRequestStatus @default(pending)
  deadline    DateTime?
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  project   Project            @relation("ProjectQuoteRequests", fields: [projectId], references: [id], onDelete: Cascade)
  creator   User               @relation("QuoteRequestCreator", fields: [createdById], references: [id], onDelete: Cascade)
  items     QuoteRequestItem[]
  responses QuoteResponse[]

  @@index([projectId])
  @@index([createdById])
  @@index([status])
  @@map("quote_requests")
}

enum QuoteRequestStatus {
  pending
  in_progress
  completed
  cancelled
}

// Quote Request Items (Materials needed)
model QuoteRequestItem {
  id             String   @id @default(uuid())
  quoteRequestId String   @map("quote_request_id")
  name           String   @db.VarChar(255)
  description    String?
  quantity       Decimal  @db.Decimal(10, 2)
  unit           String   @db.VarChar(50)
  specifications String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  @@index([quoteRequestId])
  @@map("quote_request_items")
}

// Quote Response (Supplier submits quote)
model QuoteResponse {
  id             String              @id @default(uuid())
  quoteRequestId String              @map("quote_request_id")
  supplierId     String              @map("supplier_id")
  totalAmount    Decimal             @db.Decimal(12, 2)
  validUntil     DateTime?           @map("valid_until")
  notes          String?             @db.Text
  status         QuoteResponseStatus @default(submitted)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  quoteRequest QuoteRequest        @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  supplier     Organization        @relation("SupplierQuoteResponses", fields: [supplierId], references: [id], onDelete: Cascade)
  items        QuoteResponseItem[]
  negotiations Negotiation[]
  order        Order?

  @@index([quoteRequestId])
  @@index([supplierId])
  @@index([status])
  @@map("quote_responses")
}

enum QuoteResponseStatus {
  submitted
  under_review
  approved
  rejected
  negotiating
  expired
}

// Quote Response Items (Supplier's pricing)
model QuoteResponseItem {
  id                 String   @id @default(uuid())
  quoteResponseId    String   @map("quote_response_id")
  quoteRequestItemId String?  @map("quote_request_item_id")
  productId          String?  @map("product_id")
  name               String   @db.VarChar(255)
  quantity           Decimal  @db.Decimal(10, 2)
  unit               String   @db.VarChar(50)
  price              Decimal  @db.Decimal(12, 2)
  total              Decimal  @db.Decimal(12, 2)
  notes              String?  @db.Text
  createdAt          DateTime @default(now()) @map("created_at")

  quoteResponse QuoteResponse @relation(fields: [quoteResponseId], references: [id], onDelete: Cascade)
  product       Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteResponseId])
  @@index([productId])
  @@map("quote_response_items")
}

// Negotiation (QS negotiates with supplier)
model Negotiation {
  id              String            @id @default(uuid())
  quoteResponseId String            @map("quote_response_id")
  initiatedBy     String            @db.VarChar(20) // qs | supplier
  message         String            @db.Text
  proposedAmount  Decimal?          @db.Decimal(12, 2)
  status          NegotiationStatus @default(open)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  quoteResponse QuoteResponse @relation(fields: [quoteResponseId], references: [id], onDelete: Cascade)

  @@index([quoteResponseId])
  @@index([status])
  @@map("negotiations")
}

enum NegotiationStatus {
  open
  accepted
  rejected
  counter_offered
}

// Order (After quote approval)
model Order {
  id                   String      @id @default(uuid())
  quoteResponseId      String      @unique @map("quote_response_id")
  projectId            String      @map("project_id")
  supplierId           String      @map("supplier_id")
  orderNumber          String      @unique @db.VarChar(50)
  totalAmount          Decimal     @db.Decimal(12, 2)
  status               OrderStatus @default(pending)
  orderDate            DateTime    @default(now()) @map("order_date")
  expectedDeliveryDate DateTime?   @map("expected_delivery_date")
  actualDeliveryDate   DateTime?   @map("actual_delivery_date")
  deliveryAddress      String?     @map("delivery_address") @db.VarChar(500)
  notes                String?     @db.Text
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  quoteResponse     QuoteResponse      @relation(fields: [quoteResponseId], references: [id], onDelete: Cascade)
  project           Project            @relation("ProjectOrders", fields: [projectId], references: [id], onDelete: Cascade)
  supplier          Organization       @relation("SupplierOrders", fields: [supplierId], references: [id], onDelete: Cascade)
  items             OrderItem[]
  deliveries        Delivery[]
  certificates      Certificate[]
  payments          Payment[]
  qualityInspection QualityInspection?

  @@index([projectId])
  @@index([supplierId])
  @@index([status])
  @@index([orderNumber])
  @@map("orders")
}

enum OrderStatus {
  pending
  confirmed
  in_production
  ready_for_delivery
  in_transit
  delivered
  quality_check
  quality_approved
  quality_rejected
  completed
  cancelled
}

// Order Items
model OrderItem {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  productId String?  @map("product_id")
  name      String   @db.VarChar(255)
  quantity  Decimal  @db.Decimal(10, 2)
  unit      String   @db.VarChar(50)
  price     Decimal  @db.Decimal(12, 2)
  total     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation("OrderProduct", fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// Delivery Tracking
model Delivery {
  id             String         @id @default(uuid())
  orderId        String         @map("order_id")
  status         DeliveryStatus @default(scheduled)
  trackingNumber String?        @map("tracking_number") @db.VarChar(100)
  carrier        String?        @db.VarChar(100)
  estimatedDate  DateTime?      @map("estimated_date")
  actualDate     DateTime?      @map("actual_date")
  deliveryNotes  String?        @map("delivery_notes") @db.Text
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("deliveries")
}

enum DeliveryStatus {
  scheduled
  in_transit
  out_for_delivery
  delivered
  delayed
  failed
}

// Quality Inspection
model QualityInspection {
  id             String        @id @default(uuid())
  orderId        String        @unique @map("order_id")
  inspectedBy    String        @map("inspected_by")
  status         QualityStatus @default(pending)
  notes          String?       @db.Text
  inspectionDate DateTime?     @map("inspection_date")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("quality_inspections")
}

enum QualityStatus {
  pending
  passed
  failed
  conditional
}

// Certificates
model Certificate {
  id         String            @id @default(uuid())
  orderId    String            @map("order_id")
  type       CertificateType
  title      String            @db.VarChar(255)
  fileUrl    String?           @map("file_url") @db.VarChar(500)
  issuedBy   String?           @map("issued_by") @db.VarChar(255)
  issueDate  DateTime?         @map("issue_date")
  expiryDate DateTime?         @map("expiry_date")
  status     CertificateStatus @default(requested)
  uploadedBy String?           @map("uploaded_by") @db.VarChar(50) // supplier | qs
  notes      String?           @db.Text
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([type])
  @@map("certificates")
}

enum CertificateType {
  material_certificate
  test_certificate
  quality_certificate
  compliance_certificate
  warranty_certificate
}

enum CertificateStatus {
  requested
  submitted
  under_review
  approved
  rejected
}

// Payment
model Payment {
  id            String        @id @default(uuid())
  orderId       String        @map("order_id")
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(pending)
  paymentDate   DateTime?     @map("payment_date")
  paymentMethod String?       @map("payment_method") @db.VarChar(50)
  reference     String?       @db.VarChar(100)
  notes         String?       @db.Text
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

enum PaymentStatus {
  pending
  approved
  processed
  completed
  failed
  cancelled
}

// Tenant (Legacy/Coexistence model - maps to tenants table)
model Tenant {
  id              String       @id @default(uuid())
  name            String       @db.VarChar(255)
  type            TenantType
  email           String       @unique @db.VarChar(255)
  phone           String?      @db.VarChar(50)
  address         String?      @db.Text
  postalCode      String?      @map("postal_code") @db.VarChar(20)
  logoUrl         String?      @map("logo_url") @db.VarChar(500)
  status          TenantStatus @default(pending)
  isActive        Boolean      @default(false) @map("is_active")
  approvedBy      String?      @map("approved_by")
  approvedAt      DateTime?    @map("approved_at")
  rejectedBy      String?      @map("rejected_by")
  rejectedAt      DateTime?    @map("rejected_at")
  rejectionReason String?      @map("rejection_reason") @db.Text
  metadata        Json?        @default("{}")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  privatePrices PrivatePrice[] @relation("TenantPrivatePrices")
  priceViews    PriceView[]    @relation("TenantPriceViews")

  @@index([type])
  @@index([status])
  @@index([isActive])
  @@index([status, type])
  @@map("tenants")
}

// Default Prices (Historical price tracking)
model DefaultPrice {
  id             String    @id @default(uuid())
  productId      String    @map("product_id")
  price          Decimal   @db.Decimal(12, 2)
  currency       String    @default("USD") @db.VarChar(3)
  effectiveFrom  DateTime  @default(now()) @map("effective_from")
  effectiveUntil DateTime? @map("effective_until")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isActive])
  @@index([effectiveFrom, effectiveUntil])
  @@map("default_prices")
}

// Private Prices (Company-specific pricing)
model PrivatePrice {
  id                 String    @id @default(uuid())
  productId          String    @map("product_id")
  companyId          String    @map("company_id")
  price              Decimal?  @db.Decimal(12, 2)
  discountPercentage Decimal?  @map("discount_percentage") @db.Decimal(5, 2)
  currency           String    @default("USD") @db.VarChar(3)
  effectiveFrom      DateTime  @default(now()) @map("effective_from")
  effectiveUntil     DateTime? @map("effective_until")
  isActive           Boolean   @default(true) @map("is_active")
  notes              String?   @db.Text
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation("TenantPrivatePrices", fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([productId, companyId, effectiveFrom])
  @@index([productId])
  @@index([companyId])
  @@index([isActive])
  @@index([effectiveFrom, effectiveUntil])
  @@map("private_prices")
}

// Price Audit Log (Track all price changes)
model PriceAuditLog {
  id           String    @id @default(uuid())
  productId    String    @map("product_id")
  priceType    PriceType @map("price_type")
  companyId    String?   @map("company_id")
  oldPrice     Decimal?  @map("old_price") @db.Decimal(12, 2)
  newPrice     Decimal   @map("new_price") @db.Decimal(12, 2)
  changedBy    String    @map("changed_by")
  changedAt    DateTime  @default(now()) @map("changed_at")
  changeReason String?   @map("change_reason") @db.Text
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  userAgent    String?   @map("user_agent") @db.Text

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation("PriceAuditLogUser", fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([companyId])
  @@index([changedBy])
  @@index([changedAt])
  @@index([priceType])
  @@map("price_audit_log")
}

// ─── AI Procurement Agent Models ────────────────────────────────────────────

// ProcurementRequest — top-level record created from a QS natural-language prompt
model ProcurementRequest {
  id              String                    @id @default(uuid())
  organizationId  String                    @map("organization_id")
  createdById     String                    @map("created_by_id")
  rawPrompt       String                    @map("raw_prompt") @db.Text
  product         String                    @db.VarChar(255)
  location        String?                   @db.VarChar(255)
  constraints     Json?                     @default("{}") // price limit, quantity, timeline, etc.
  status          ProcurementStatus         @default(draft)
  rfqSubject      String?                   @map("rfq_subject") @db.VarChar(500)
  rfqBody         String?                   @map("rfq_body") @db.Text
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  organization    Organization              @relation("OrgProcurementRequests", fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User                      @relation("UserProcurementRequests", fields: [createdById], references: [id], onDelete: Cascade)
  supplierCandidates RfqSupplierCandidate[]
  communications  RfqCommunication[]
  quotationResponses QuotationResponse[]

  @@index([organizationId])
  @@index([createdById])
  @@index([status])
  @@map("procurement_requests")
}

enum ProcurementStatus {
  draft
  searching
  rfq_sent
  evaluating
  awarded
  closed
}

// RfqSupplierCandidate — a supplier (internal or web-discovered) linked to a ProcurementRequest
model RfqSupplierCandidate {
  id                    String              @id @default(uuid())
  procurementRequestId  String              @map("procurement_request_id")
  organizationId        String?             @map("organization_id") // null for web-discovered
  companyName           String              @map("company_name") @db.VarChar(255)
  contactEmail          String?             @map("contact_email") @db.VarChar(255)
  contactPhone          String?             @map("contact_phone") @db.VarChar(100)
  contactWhatsapp       String?             @map("contact_whatsapp") @db.VarChar(100)
  website               String?             @db.VarChar(500)
  address               String?             @db.VarChar(500)
  source                CandidateSource     @default(internal)
  rankScore             Float               @default(0) @map("rank_score")
  isSelected            Boolean             @default(true) @map("is_selected")
  createdAt             DateTime            @default(now()) @map("created_at")

  procurementRequest    ProcurementRequest  @relation(fields: [procurementRequestId], references: [id], onDelete: Cascade)
  organization          Organization?       @relation("OrgSupplierCandidates", fields: [organizationId], references: [id], onDelete: SetNull)
  communications        RfqCommunication[]
  quotationResponses    QuotationResponse[]

  @@index([procurementRequestId])
  @@index([organizationId])
  @@map("rfq_supplier_candidates")
}

enum CandidateSource {
  internal
  web
}

// RfqCommunication — each outbound or inbound message per supplier per channel
model RfqCommunication {
  id                    String              @id @default(uuid())
  procurementRequestId  String              @map("procurement_request_id")
  supplierCandidateId   String              @map("supplier_candidate_id")
  direction             CommDirection       @default(outbound)
  channel               CommChannel
  toAddress             String?             @map("to_address") @db.VarChar(255)
  subject               String?             @db.VarChar(500)
  body                  String              @db.Text
  externalMessageId     String?             @map("external_message_id") @db.VarChar(500)
  deliveryStatus        String?             @map("delivery_status") @db.VarChar(50)
  rawReply              String?             @map("raw_reply") @db.Text
  sentAt                DateTime?           @map("sent_at")
  receivedAt            DateTime?           @map("received_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  procurementRequest    ProcurementRequest  @relation(fields: [procurementRequestId], references: [id], onDelete: Cascade)
  supplierCandidate     RfqSupplierCandidate @relation(fields: [supplierCandidateId], references: [id], onDelete: Cascade)

  @@index([procurementRequestId])
  @@index([supplierCandidateId])
  @@index([channel])
  @@map("rfq_communications")
}

enum CommDirection {
  outbound
  inbound
}

enum CommChannel {
  email
  whatsapp
}

// QuotationResponse — AI-parsed structured response from a supplier reply
model QuotationResponse {
  id                    String              @id @default(uuid())
  procurementRequestId  String              @map("procurement_request_id")
  supplierCandidateId   String              @map("supplier_candidate_id")
  unitPrice             Decimal?            @map("unit_price") @db.Decimal(12, 2)
  currency              String?             @db.VarChar(10)
  unit                  String?             @db.VarChar(50)
  availability          String?             @db.VarChar(255)
  deliveryDays          Int?                @map("delivery_days")
  deliveryTerms         String?             @map("delivery_terms") @db.Text
  paymentTerms          String?             @map("payment_terms") @db.Text
  validUntil            DateTime?           @map("valid_until")
  notes                 String?             @db.Text
  rawText               String?             @map("raw_text") @db.Text
  confidence            Float?
  isAwarded             Boolean             @default(false) @map("is_awarded")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  procurementRequest    ProcurementRequest  @relation(fields: [procurementRequestId], references: [id], onDelete: Cascade)
  supplierCandidate     RfqSupplierCandidate @relation(fields: [supplierCandidateId], references: [id], onDelete: Cascade)

  @@index([procurementRequestId])
  @@index([supplierCandidateId])
  @@map("quotation_responses")
}

// ─── End AI Procurement Agent Models ─────────────────────────────────────────

// Price Views (Track price views for analytics)
model PriceView {
  id        String    @id @default(uuid())
  productId String    @map("product_id")
  companyId String    @map("company_id")
  userId    String?   @map("user_id")
  viewedAt  DateTime  @default(now()) @map("viewed_at")
  priceType PriceType @map("price_type")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation("TenantPriceViews", fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation("PriceViewUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([companyId])
  @@index([viewedAt])
  @@map("price_views")
}
