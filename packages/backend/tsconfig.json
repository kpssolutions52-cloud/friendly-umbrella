{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@platform/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/__tests__/**",
    "**/e2e/**",
    "prisma/seed.ts",
    "clear-database.ts",
    "**/*.spec.ts",
    "src/middleware/auth.ts",
    "src/routes/authRoutes.ts",
    "src/routes/productRoutes.ts",
    "src/routes/priceRoutes.ts",
    "src/routes/supplierRoutes.ts",
    "src/routes/supplierProfileRoutes.ts",
    "src/routes/productImageRoutes.ts",
    "src/routes/superAdminRoutes.ts",
    "src/routes/categoryRoutes.ts",
    "src/routes/serviceCategoryRoutes.ts",
    "src/routes/publicCategoryRoutes.ts",
    "src/routes/publicServiceCategoryRoutes.ts",
    "src/routes/tenantAdminRoutes.ts",
    "src/routes/publicRoutes.ts",
    "src/routes/companyRoutes.ts",
    "src/routes/quoteRoutes.ts",
    "src/routes/serviceProviderProfileRoutes.ts",
    "src/services/authService.ts",
    "src/services/productService.ts",
    "src/services/priceService.ts",
    "src/services/categoryService.ts",
    "src/services/serviceCategoryService.ts",
    "src/services/superAdminService.ts",
    "src/services/tenantAdminService.ts",
    "src/services/quoteService.ts",
    "src/services/aiQuoteService.ts",
    "src/utils/db.ts",
    "src/websocket/handlers/quoteUpdates.ts",
    "src/services/cacheService.ts"
  ]
}












